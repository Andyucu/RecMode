<Window x:Class="RecMode.App.Views.AudioDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RecMode.App.Resources"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height"
        Width="420" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource StrokeCardBrush}"
            BorderThickness="1" CornerRadius="8">
        <StackPanel Margin="20">
            <TextBlock x:Name="TitleBar" Text="{x:Static res:Strings.AudioDevicePicker_Title}"
                       Style="{StaticResource SubtitleText}" Margin="0,0,0,4"
                       MouseLeftButtonDown="OnTitleBarDrag" />
            <TextBlock Text="{x:Static res:Strings.AudioDevicePicker_AutomaticDesc}" Style="{StaticResource SettingsCardDesc}"
                       TextWrapping="Wrap" Margin="0,0,0,16" Visibility="{Binding UseAutomatic, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{x:Static res:Strings.AudioDevicePicker_CustomDesc}" Style="{StaticResource SettingsCardDesc}"
                       TextWrapping="Wrap" Margin="0,0,0,16" Visibility="{Binding UseCustom, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton Style="{StaticResource SegmentedButton}" GroupName="audioDeviceMode"
                             Content="{x:Static res:Strings.AudioDevicePicker_Automatic}"
                             ToolTip="{x:Static res:Strings.AudioDevicePicker_AutomaticTooltip}"
                             IsChecked="{Binding UseAutomatic, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource SegmentedButton}" GroupName="audioDeviceMode"
                             Content="{x:Static res:Strings.AudioDevicePicker_Custom}"
                             ToolTip="{x:Static res:Strings.AudioDevicePicker_CustomTooltip}"
                             IsChecked="{Binding UseCustom, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel IsEnabled="{Binding UseCustom}">
                <ItemsControl ItemsSource="{Binding Devices}" MaxHeight="260">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static res:Strings.AudioDevicePicker_DefaultTag}" Style="{StaticResource CaptionText}"
                                                   ToolTip="{x:Static res:Strings.AudioDevicePicker_DefaultTagTooltip}"
                                                   Visibility="{Binding IsDefaultConsole, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static res:Strings.AudioDevicePicker_CommsTag}" Style="{StaticResource CaptionText}"
                                                   ToolTip="{x:Static res:Strings.AudioDevicePicker_CommsTagTooltip}"
                                                   Visibility="{Binding IsDefaultCommunications, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Static res:Strings.AudioDevicePicker_NoDevices}" Style="{StaticResource SettingsCardDesc}"
                           Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,0,0,10" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="{x:Static res:Strings.ScheduleEdit_Cancel}" Click="OnCancel"
                        Style="{StaticResource SecondaryButton}" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="{x:Static res:Strings.ScheduleEdit_Save}" Click="OnSave"
                        Style="{StaticResource AccentButton}" Width="90" Height="32" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
