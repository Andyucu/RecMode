<UserControl x:Class="RecMode.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RecMode.App.Resources"
             xmlns:vm="clr-namespace:RecMode.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static res:Strings.Nav_About}" Style="{StaticResource TitleText}" Margin="0,0,0,6" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="pack://application:,,,/Assets/AppIcon.png" Width="48" Height="48"
                           VerticalAlignment="Center" Margin="0,0,16,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionInfo}" Style="{StaticResource BodyStrongText}" />
                        <TextBlock Text="{x:Static res:Strings.About_Description}" Style="{StaticResource SettingsCardDesc}" />
                        <TextBlock Text="{Binding RuntimeInfo}" Style="{StaticResource SettingsCardDesc}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{x:Static res:Strings.About_PrivacyTitle}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CardIcon}" Text="&#xE72E;" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.About_PrivacyBody}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Style="{StaticResource SettingsCardDesc}" />
                </Grid>
            </Border>

            <TextBlock Text="{x:Static res:Strings.About_Links}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CardIcon}" Text="&#xE774;" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.About_GitHubHeader}" VerticalAlignment="Center" Style="{StaticResource BodyStrongText}" />
                    <Button Grid.Column="2" Content="{x:Static res:Strings.About_ViewOnGitHub}" Style="{StaticResource SecondaryButton}"
                            ToolTip="{x:Static res:Strings.About_GitHubTooltip}"
                            Command="{Binding OpenGitHubCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CardIcon}" Text="&#xE7C3;" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Settings_License}" VerticalAlignment="Center" Style="{StaticResource BodyStrongText}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="{x:Static res:Strings.About_License}" Style="{StaticResource SecondaryButton}"
                                ToolTip="{x:Static res:Strings.About_LicenseTooltip}" Margin="0,0,8,0"
                                Command="{Binding OpenLicenseCommand}" />
                        <Button Content="{x:Static res:Strings.About_ThirdPartyNotices}" Style="{StaticResource SecondaryButton}"
                                ToolTip="{x:Static res:Strings.About_ThirdPartyNoticesTooltip}"
                                Command="{Binding OpenThirdPartyNoticesCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{x:Static res:Strings.About_CheckForUpdates}" Style="{StaticResource SettingsCardDesc}" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
