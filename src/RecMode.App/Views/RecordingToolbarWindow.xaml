<Window x:Class="RecMode.App.Views.RecordingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RecMode.App.Resources"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Icon-only button chrome (SecondaryButton's hover/pressed-color/scale behavior, sized square for a
             single Segoe Fluent Icons glyph instead of a text label). -->
        <Style x:Key="ToolbarIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeControlBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Same chrome as ToolbarIconButton, but a ToggleButton — used for Pin, whose glyph turns the accent
             color while checked (same on/off color-swap pattern the Draw/Zoom/Mute/Highlight buttons already
             use, just driven by IsChecked instead of a bound viewmodel flag). -->
        <Style x:Key="ToolbarIconToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeControlBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A 2x3 dot grid, the standard "grab here" affordance — decoration only. Dragging already works
             from anywhere on the toolbar's plain background (buttons handle their own clicks first), this
             just makes the two ends visibly draggable instead of relying on users discovering it by accident. -->
        <Style x:Key="DragGrip" TargetType="UniformGrid">
            <Setter Property="Rows" Value="3" />
            <Setter Property="Columns" Value="2" />
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>
        <Style x:Key="DragGripDot" TargetType="Ellipse">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="3" />
            <Setter Property="Margin" Value="0.5" />
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </Window.Resources>

    <!-- 50% larger overall (direct user request), via a single LayoutTransform rather than hand-scaling every
         literal size in this file — LayoutTransform runs before layout, so the window's own SizeToContent
         measurement (and the drag/position math in the code-behind, which reads ActualWidth/ActualHeight)
         already sees the enlarged size correctly; every icon, button, grip, and text element scales uniformly
         and stays in proportion with no risk of missing one. -->
    <Border Background="{DynamicResource SurfaceAcrylicBrush}" BorderBrush="{DynamicResource StrokeCardBrush}"
            BorderThickness="1" CornerRadius="8" Padding="6,6,10,6" UseLayoutRounding="False">
        <!-- UseLayoutRounding=False here (overriding the app-wide Window style's own True default, which
             doesn't cascade to children anyway but is worth being explicit about): layout rounding snaps
             coordinates to whole device pixels BEFORE this Border's own LayoutTransform runs, but a 1.5×
             scale means a value rounded to a whole pixel pre-transform lands back on a fractional pixel
             post-transform anyway — the rounding is not just useless under a non-1:1 transform, it can
             introduce small inconsistent gaps between elements that would otherwise render as smooth,
             uniformly anti-aliased vector edges. -->
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
        </Border.LayoutTransform>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Left drag grip -->
            <Border Padding="2,0,10,0" Cursor="SizeAll" Background="Transparent" ToolTip="Drag to move">
                <UniformGrid Style="{StaticResource DragGrip}">
                    <Ellipse Style="{StaticResource DragGripDot}" /><Ellipse Style="{StaticResource DragGripDot}" />
                    <Ellipse Style="{StaticResource DragGripDot}" /><Ellipse Style="{StaticResource DragGripDot}" />
                    <Ellipse Style="{StaticResource DragGripDot}" /><Ellipse Style="{StaticResource DragGripDot}" />
                </UniformGrid>
            </Border>

            <Ellipse x:Name="RecDot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource CriticalBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Fill" Value="#F7A400" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                <Setter Property="Fill" Value="#F7A400" />
                            </DataTrigger>
                            <!-- Recording pulse (design: rm-blink 1.2s infinite — opacity 1 → 0.25, stops while paused) -->
                            <DataTrigger Binding="{Binding IsPaused}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="RecDotBlink">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="0.25" />
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RecDotBlink" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource MonoText}" FontSize="13"
                       MinWidth="52" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />

            <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource StrokeCardBrush}" />

            <!-- Every icon below is hand-drawn (Canvas of Shapes bound to the button's own Foreground) rather
                 than a Segoe Fluent Icons glyph — a font-glyph icon set was tried first, but several of these
                 codepoints render as blank "tofu" boxes on this machine (the exact same class of font-glyph
                 failure CLAUDE.md documents for the caption-button/chevron icons, which were fixed the same
                 way: hand-drawn vectors instead of trusting the icon font). Guaranteed to render regardless of
                 which icon fonts are actually installed/mapped. -->

            <!-- Pause/Resume: two bars vs. a triangle, swapped via IsPaused. -->
            <Button Command="{Binding PauseResumeCommand}" Style="{StaticResource ToolbarIconButton}"
                    ToolTip="{x:Static res:Strings.Record_PauseResumeTooltip}"
                    AutomationProperties.Name="{Binding PauseButtonText}" Margin="0">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Canvas.Resources>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Style>
                            <Style TargetType="Polygon">
                                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Style>
                        </Canvas.Resources>
                        <Rectangle Canvas.Left="4" Canvas.Top="3" Width="3" Height="10"
                                   Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Rectangle Canvas.Left="9" Canvas.Top="3" Width="3" Height="10"
                                   Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Polygon Points="5,3 5,13 13,8"
                                 Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button Command="{Binding ScreenshotCommand}" Style="{StaticResource ToolbarIconButton}"
                    ToolTip="{x:Static res:Strings.Record_ScreenshotTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.Record_Screenshot}" Margin="6,0,0,0">
                <!-- Camera: body outline + viewfinder bump + lens. Stroke/Fill set directly on each shape
                     rather than via an implicit Canvas.Resources style keyed TargetType="Shape" — WPF's
                     implicit-style lookup matches an element's *exact* runtime type against the resource key,
                     it does not walk up to a base type like Shape, so Rectangle/Ellipse elements silently
                     never picked up that style at all (found live: this rendered as a fully invisible icon,
                     not merely a wrong color). -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="2" Canvas.Top="5.5" Width="12" Height="8" RadiusX="1.5" RadiusY="1.5"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.6" Fill="Transparent" />
                        <Rectangle Canvas.Left="6" Canvas.Top="3" Width="4" Height="2.5" RadiusX="0.6" RadiusY="0.6"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.6" Fill="Transparent" />
                        <Ellipse Canvas.Left="5.5" Canvas.Top="7" Width="5" Height="5"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="1.6" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button Command="{Binding ToggleAnnotateCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_DrawTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.Record_Annotate}" Margin="6,0,0,0">
                <!-- Paintbrush with a drip — a plain pencil reads as "edit text" (that's its usual meaning
                     everywhere, including this app's own Settings icons); this feature is freehand ink drawn
                     directly on screen, which a brush + paint drip suggests far more directly. -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Line X1="13" Y1="3" X2="9" Y2="7"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Polygon Points="9,7 11.5,9.3 3,14"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Ellipse Canvas.Left="1.3" Canvas.Top="13.7" Width="2.2" Height="2.2"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                </Viewbox>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAnnotating}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding ToggleManualZoomCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_ZoomTooltip}"
                    AutomationProperties.Name="{Binding ZoomButtonText}" Margin="6,0,0,0">
                <!-- Magnifying glass: ring + handle. -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="8" Height="8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" Fill="Transparent" />
                        <Line X1="9.5" Y1="9.5" X2="14" Y2="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManualZooming}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding ToggleMicMuteCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_MuteMicTooltip}"
                    AutomationProperties.Name="{Binding MicMuteButtonText}" Margin="6,0,0,0">
                <!-- Microphone: capsule + cradle + stand. Same fix as the camera icon above — every shape now
                     sets its own Stroke/Fill directly instead of relying on a base-typed implicit style. -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="6" Canvas.Top="2" Width="4" Height="7" RadiusX="2" RadiusY="2"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.6" Fill="Transparent" />
                        <Polyline Points="4,8 4,9.5 6,12 10,12 12,9.5 12,8" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" Fill="Transparent" />
                        <Line X1="8" Y1="12" X2="8" Y2="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                        <Line X1="5" Y1="14" X2="11" Y2="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                    </Canvas>
                </Viewbox>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Mic noise suppression: reduces background hiss/fan/rumble in the mixed audio. Accent while on.
                 The raw mic (separate track) is never touched, so this is non-destructive. -->
            <Button Command="{Binding ToggleMicNoiseSuppressionCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_NoiseSuppressionTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_NoiseSuppressionLabel}" Margin="6,0,0,0">
                <!-- Waveform with a slash: "quieter background". -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Line X1="4" Y1="6" X2="4" Y2="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="7.5" Y1="3.5" X2="7.5" Y2="12.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="11" Y1="6" X2="11" Y2="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="3" Y1="13.5" X2="13" Y2="2.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMicNoiseSuppressionEnabled}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding ToggleHighlightClicksCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_HighlightClicksTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_HighlightClicksLabel}" Margin="6,0,0,0">
                <!-- Click ripple: ring + centre dot. -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" Fill="Transparent" />
                        <Ellipse Canvas.Left="6.5" Canvas.Top="6.5" Width="3" Height="3"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                </Viewbox>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlightingClicks}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Privacy: live redaction. Always present (the user looked for it here) — dimmed/disabled when
                 there's no marked area yet, or the active capture can't blank one, so it never arms a no-op
                 or lights up over an unredacted file. The glyph turns accent while armed. -->
            <Button Command="{Binding ToggleRedactionCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_RedactTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_RedactLabel}" Margin="6,0,0,0"
                    IsEnabled="{Binding CanToggleRedaction}">
                <!-- Redact: a marked rectangle with a diagonal strike through it. -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="2.5" Canvas.Top="3.5" Width="11" Height="9" RadiusX="1.5" RadiusY="1.5"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.6" Fill="Transparent" />
                        <Line X1="3.5" Y1="12.5" X2="12.5" Y2="3.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRedacting}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Chapter marker: stamps a chapter at the current moment, into the file as a real seekable
                 chapter (hotkey too, default Ctrl+Shift+K). The counter next to it is the hotkey's only
                 feedback, so it only appears once something has actually been stamped. -->
            <Button Command="{Binding AddChapterCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_AddChapterTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.Toolbar_AddChapterLabel}" Margin="6,0,0,0">
                <!-- Bookmark ribbon. -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Polygon Points="4,2.5 12,2.5 12,13.5 8,10.5 4,13.5"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>
            <TextBlock Text="{Binding ChapterCount}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="4,0,0,0"
                       Visibility="{Binding HasChapters, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.Name="{x:Static res:Strings.Toolbar_ChaptersLabel}" />

            <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource StrokeCardBrush}" />

            <TextBlock Text="{Binding StatsText}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" MinWidth="140" />

            <Button Command="{Binding RecordCommand}"
                    ToolTip="{x:Static res:Strings.Toolbar_StopTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.Record_Stop}" Margin="8,0,0,0">
                <!-- Stop: filled square. -->
                <Viewbox Width="12" Height="12">
                    <Rectangle Width="16" Height="16" RadiusX="2" RadiusY="2"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Viewbox>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                        <Setter Property="Background" Value="{DynamicResource CriticalBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </Button.Style>
            </Button>

            <!-- Pin: locks the current position so it survives to the next recording instead of resetting. -->
            <ToggleButton x:Name="PinToggle" Checked="OnPinToggled" Unchecked="OnPinToggled" Margin="6,0,0,0"
                          AutomationProperties.Name="{x:Static res:Strings.Toolbar_PinLabel}">
                <!-- Pin: ring "head" + pointed base. -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="4" Canvas.Top="2" Width="8" Height="8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6" Fill="Transparent" />
                        <Polygon Points="6,9 10,9 8,14"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Canvas>
                </Viewbox>
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolbarIconToggleButton}">
                        <Setter Property="ToolTip" Value="{x:Static res:Strings.Toolbar_PinTooltip}" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="ToolTip" Value="{x:Static res:Strings.Toolbar_UnpinTooltip}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <!-- Right drag grip -->
            <Border Padding="8,0,2,0" Cursor="SizeAll" Background="Transparent" ToolTip="Drag to move">
                <UniformGrid Style="{StaticResource DragGrip}">
                    <Ellipse Style="{StaticResource DragGripDot}" /><Ellipse Style="{StaticResource DragGripDot}" />
                    <Ellipse Style="{StaticResource DragGripDot}" /><Ellipse Style="{StaticResource DragGripDot}" />
                    <Ellipse Style="{StaticResource DragGripDot}" /><Ellipse Style="{StaticResource DragGripDot}" />
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</Window>
